# ============================================================
# 【可选】首次播种文件 —— 2026-10 起配置已改为网页管理:
#   打开面板 → 右上角「⚙ 设置」→ 填写/修改 → 保存即时生效。
# 运行时配置存于 Docker 卷 mirror_data 的 /app/data/config.json。
#
# 本文件(及环境变量)只在数据卷里还没有 config.json 时被读取一次,
# 用于初始化;之后修改这里不再有任何效果。
# ============================================================

# GitHub PAT:https://github.com/settings/tokens 勾 repo(+read:org 镜像组织)
GITHUB_TOKEN=
GITHUB_ORGS=
INCLUDE_FORKS=1

# Gitea:API 地址(容器编排内为 http://gitea:3000;本机直跑填 http://localhost:13654)
GITEA_URL=http://gitea:3000
GITEA_PUBLIC_URL=http://localhost:13654
# token 需 repository + organization + user 读权限(缺 read:user 会 403)
GITEA_TOKEN=
GITEA_OWNER=

MIRROR_INTERVAL=8h0m0s
RECONCILE_EVERY_MIN=60
BACKUP_CMD=

# 唯一仍走环境变量的项:面板监听端口(容器内固定 8000,宿主机端口在 compose 映射)
APP_PORT=8000
